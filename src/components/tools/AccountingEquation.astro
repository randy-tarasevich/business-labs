---
// Accounting Equation Lab: markup only. Behavior lives in src/scripts/tools/accounting-equation.js
import TryIt from '../ui/TryIt.astro';

const PANEL = 'bg-panel border border-line rounded-[10px] p-[18px] grid gap-3.5 min-w-0 content-start';
const H2 = 'font-display font-semibold text-[18px]';
const H3 = 'font-sans text-[12px] tracking-[.06em] uppercase text-muted mb-1.5';
const TERM_K = 'text-[12px] text-muted uppercase tracking-[.06em] max-[420px]:text-[10px]';
const TERM_V = 'font-mono font-semibold text-[clamp(17px,4.6vw,32px)] leading-[normal] tabular-nums';
const OP = 'font-mono font-semibold text-[clamp(17px,4.6vw,32px)] leading-[normal] text-accent';
const BTN = 'font-sans font-semibold text-[14px] leading-[normal] text-accent bg-transparent border border-line rounded-lg py-2 px-3.5 cursor-pointer hover:border-accent';
const BTN_PRIMARY = 'font-sans font-semibold text-[14px] leading-[normal] text-panel bg-accent border border-accent rounded-lg py-2 px-3.5 cursor-pointer';
const SUBTOTAL = 'flex justify-between gap-2 text-[13.5px] py-1 px-1.5 text-muted border-t border-line [&>span:last-child]:font-mono [&>span:last-child]:tabular-nums';
const TOTAL = 'flex justify-between gap-2 text-[13.5px] py-1 px-1.5 font-bold border-t-2 border-ink [&>span:last-child]:font-mono [&>span:last-child]:tabular-nums';
const LIST = 'list-none mb-2 p-0 grid gap-0.5';
---
<div class="grid gap-[18px]" data-tool="accounting-equation">
  <section class="flex flex-wrap items-center justify-center gap-y-2 gap-x-[clamp(6px,2vw,18px)] bg-panel border border-line rounded-[10px] py-3.5 px-[18px] max-[420px]:py-3 max-[420px]:px-2" aria-label="The accounting equation, current totals">
    <div class="grid text-center min-w-0"><span class={TERM_K}>Assets</span><span class={TERM_V} data-r="eq-a">$0</span></div>
    <span class={OP} data-r="eq-sign" aria-label="equals">=</span>
    <div class="grid text-center min-w-0"><span class={TERM_K}>Liabilities</span><span class={TERM_V} data-r="eq-l">$0</span></div>
    <span class={OP}>+</span>
    <div class="grid text-center min-w-0"><span class={TERM_K}>Owner's Equity</span><span class={TERM_V} data-r="eq-e">$0</span></div>
  </section>

  <section class="grid grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] gap-[18px] items-start max-[900px]:grid-cols-1">
    <!-- The card gets data-done after the last transaction, which hides the prompt and entry form. -->
    <div class:list={[PANEL, 'group/card']} data-r="card">
      <div class="grid gap-1.5 text-[13px] text-muted font-medium">
        <span data-r="progress">Transaction 1 of 12</span>
        <div class="h-1 bg-grid rounded-[2px] overflow-hidden" aria-hidden="true"><div class="h-full w-0 bg-accent transition-[width] duration-300" data-r="bar"></div></div>
      </div>
      <p class="font-display text-[clamp(18px,2.4vw,22px)] font-semibold leading-[1.3] text-pretty" data-r="text" aria-live="polite"></p>
      <p class="text-[14px] text-muted group-data-done/card:hidden">Which accounts change, and by how much? Use a minus sign for a decrease.</p>
      <form class="grid gap-2.5 group-data-done/card:hidden" data-r="entry" onsubmit="return false"></form>
      <p class="font-mono font-medium text-[13.5px] leading-[normal] text-muted py-2 px-2.5 rounded-md bg-bg wrap-anywhere empty:hidden tone-good:text-good tone-bad:text-bad" data-r="preview" role="status"></p>
      <p class="rounded-lg py-2.5 px-3.5 text-[14.5px] tone-good:bg-good-soft tone-bad:bg-bad-soft tone-info:bg-bg" data-r="feedback" role="status" hidden></p>
      <p class="text-[15px] border-l-[3px] border-accent pl-3 max-w-[65ch]" data-r="why" hidden></p>
      <div class="flex flex-wrap gap-2">
        <button type="button" class={BTN_PRIMARY} data-act="check">Check my entry</button>
        <button type="button" class={BTN} data-act="reveal">Show answer</button>
        <button type="button" class={BTN_PRIMARY} data-act="next" hidden>Next transaction</button>
        <button type="button" class={BTN} data-act="restart" hidden>Start over</button>
      </div>
    </div>

    <div class={PANEL} aria-label="Balance sheet">
      <h2 class={H2}>Maya's Food Truck <span class="font-sans text-[13px] font-medium text-muted ml-1.5">Balance sheet</span></h2>
      <div class="grid grid-cols-2 gap-5 max-[520px]:grid-cols-1">
        <div>
          <h3 class={H3}>Assets</h3>
          <ul class={LIST} data-r="list-A"></ul>
          <p class={TOTAL}><span>Total assets</span><span data-r="total-A">$0</span></p>
        </div>
        <div>
          <h3 class={H3}>Liabilities</h3>
          <ul class={LIST} data-r="list-L"></ul>
          <p class={SUBTOTAL}><span>Total liabilities</span><span data-r="total-L">$0</span></p>
          <h3 class={H3}>Owner's Equity</h3>
          <ul class={LIST} data-r="list-E"></ul>
          <p class={SUBTOTAL}><span>Total equity</span><span data-r="total-E">$0</span></p>
          <p class={TOTAL}><span>Liabilities + Equity</span><span data-r="total-le">$0</span></p>
        </div>
      </div>
    </div>
  </section>

  <section class="grid grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] gap-[18px] items-start max-[900px]:grid-cols-1">
    <div class={PANEL}>
      <h2 class={H2}>Journal</h2>
      <p class="text-muted text-[14px]" data-r="journal-empty">Posted transactions show up here.</p>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-[13.5px] [&_th]:text-left [&_td]:text-left [&_th]:py-1.5 [&_th]:px-2 [&_td]:py-1.5 [&_td]:px-2 [&_th]:align-top [&_td]:align-top [&_td]:border-t [&_td]:border-line [&_th]:text-muted [&_th]:font-semibold [&_th]:text-[12px]">
          <thead><tr><th>#</th><th>Transaction</th><th>Effect</th></tr></thead>
          <tbody data-r="journal"></tbody>
        </table>
      </div>
    </div>
    <TryIt panel={PANEL} items={[
      { q: "Transaction 3 traded $20,000 of cash for a truck. Did Maya get richer, poorer, or neither? How does the balance sheet prove it?", hint: "Compare total assets before and after transaction 3. Then look at equity.", a: "Neither. Total assets did not change and equity did not move. One asset turned into another." },
      { q: "Transactions 5 and 9 both brought in cash. Why did only one of them change owner's equity?", hint: "Look back at transaction 6. Was that money already earned?", a: "Transaction 5 was new revenue. Transaction 9 collected money already earned in transaction 6, so it just turned receivables into cash." },
      { q: "Can a transaction change only one account? Try to invent one, then explain what goes wrong.", hint: "Change just one account. What would have to happen to keep both sides equal?", a: "No. If one account changes and nothing else does, one side of the equation moves and the other doesn't. Every transaction touches at least two accounts." },
    ]} defend={{
      q: "Maya ends with $4,600 in cash and a $14,000 loan. She could use $4,000 to pay down the loan now, or keep the cash. Which would you advise, and why?",
      hint: "You can't post this one in the tool, so reason from the final balance sheet. Paying a loan isn't an expense. Which two accounts move?",
      look: [
        "Shows that paying the loan lowers cash and the loan by the same $4,000, so the equation still balances",
        "Notes that owner's equity doesn't change either way",
        "Weighs a real tradeoff, like less debt versus less cash for bills and surprises",
        "Picks one and gives a reason",
      ],
    }} />
  </section>
</div>

<script>
  import { initAccountingEquation } from '../../scripts/tools/accounting-equation.js';
  document.querySelectorAll('[data-tool="accounting-equation"]').forEach(initAccountingEquation);
</script>
