---
// Adjusting Entries Lab: markup only. Behavior lives in src/scripts/tools/adjusting-entries.js
import TryIt from '../ui/TryIt.astro';
import { PANEL, H2, H3, HINT, SELECT, NUM_INPUT_SM, NUM_UNIT, BTN, BTN_GHOST, TABLE_BOX, TABLE, VERDICT, STAT, STAT_KEY, STAT_K, STAT_V } from '../../scripts/lib/ui.js';

// Entry rows: a checked row gets data-tone="good" or "bad".
const ROW = 'grid grid-cols-[4.2rem_minmax(0,1fr)_auto] items-center gap-2 py-1.5 px-2 rounded-md border-l-[3px] border-transparent tone-good:bg-good-soft tone-good:border-good tone-bad:bg-bad-soft tone-bad:border-bad max-[420px]:grid-cols-[minmax(0,1fr)_auto] max-[420px]:[&>label]:col-span-2';
const SEL = `${SELECT} w-full min-w-0 disabled:opacity-100 disabled:text-ink`;
const AMT = `${NUM_INPUT_SM} w-[96px] disabled:opacity-100 disabled:text-ink`;
const KINDS = 'w-full border-collapse text-[13.5px] [&_th]:text-left [&_th]:align-top [&_th]:py-1.5 [&_th]:pr-2 [&_td]:py-1.5 [&_td]:border-t [&_th]:border-t [&_td]:border-line [&_th]:border-line [&_th]:font-semibold [&_th]:whitespace-nowrap';
// Worksheet: two header rows, three column pairs. Narrow screens scroll inside the box, not the page.
// The Account column stays pinned while the numbers scroll.
const WS = `${TABLE} text-[13px] min-w-[640px] [&_tbody_th]:sticky [&_tbody_th]:left-0 [&_tbody_th]:z-1 [&_tbody_th]:bg-panel [&_tfoot_th]:sticky [&_tfoot_th]:left-0 [&_tfoot_th]:bg-panel [&_thead_tr:last-child_th:first-child]:sticky [&_thead_tr:last-child_th:first-child]:left-0 [&_thead_tr:last-child_th:first-child]:bg-panel max-[700px]:[&_tbody_th]:max-w-[9.5rem] max-[700px]:[&_tbody_th]:pr-2 [&_thead_tr:first-child_th]:text-center [&_thead_tr:first-child_th]:text-ink [&_td]:align-top [&_td:nth-child(4)]:border-l-2 [&_td:nth-child(6)]:border-l-2 [&_td:nth-child(4)]:border-l-line [&_td:nth-child(6)]:border-l-line`;
---
<div class="grid gap-[18px]" data-tool="adjusting-entries">
  <section class="grid grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] gap-[18px] items-start max-[900px]:grid-cols-1">
    <div class:list={[PANEL, 'group/card']} data-r="card">
      <div class="grid gap-1.5 text-[13px] text-muted font-medium">
        <span data-r="progress">Adjustment a (1 of 7)</span>
        <div class="h-1 bg-grid rounded-[2px] overflow-hidden" aria-hidden="true"><div class="h-full w-0 bg-accent transition-[width] duration-300" data-r="bar"></div></div>
      </div>
      <p class="font-display text-[clamp(18px,2.4vw,22px)] font-semibold leading-[1.3] text-pretty" data-r="text" aria-live="polite"></p>
      <form class="grid gap-2 group-data-done/card:hidden" onsubmit="return false" aria-label="Adjusting entry">
        <p class="text-[14px] text-muted">Write the adjusting entry. Work out the amount for this month, then pick the accounts.</p>
        <div class={ROW} data-r="dr-row">
          <label for="ae-dr" class="font-semibold text-[14px]">Debit</label>
          <select id="ae-dr" class={SEL}></select>
          <span class="flex items-center gap-1"><span class={NUM_UNIT}>$</span><input id="ae-dr-amt" type="number" min="0" step="1" inputmode="numeric" placeholder="0" aria-label="Debit amount in dollars" class={AMT} /></span>
        </div>
        <div class:list={[ROW, 'pl-6']} data-r="cr-row">
          <label for="ae-cr" class="font-semibold text-[14px]">Credit</label>
          <select id="ae-cr" class={SEL}></select>
          <span class="flex items-center gap-1"><span class={NUM_UNIT}>$</span><input id="ae-cr-amt" type="number" min="0" step="1" inputmode="numeric" placeholder="0" aria-label="Credit amount in dollars" class={AMT} /></span>
        </div>
      </form>
      <p class="rounded-lg py-2.5 px-3.5 text-[14.5px] tone-good:bg-good-soft tone-bad:bg-bad-soft tone-info:bg-bg" data-r="feedback" role="status" hidden></p>
      <span class="justify-self-start rounded-full bg-accent/12 text-ink px-2.5 py-0.5 text-[12.5px] font-semibold" data-r="kind" hidden></span>
      <p class="text-[15px] border-l-[3px] border-accent pl-3 max-w-[65ch]" data-r="why" hidden></p>
      <div class="flex flex-wrap gap-2">
        <button type="button" class={BTN} data-act="check">Check my entry</button>
        <button type="button" class={BTN_GHOST} data-act="reveal">Show answer</button>
        <button type="button" class={BTN} data-act="next" hidden>Next adjustment</button>
        <button type="button" class={BTN_GHOST} data-act="restart" hidden>Start over</button>
      </div>
    </div>

    <div class="grid gap-[18px]">
      <div class={PANEL}>
        <h2 class={H2}>Net income</h2>
        <div class="grid grid-cols-2 gap-3">
          <div class={STAT}><span class={STAT_K}>Before adjustments</span><span class={STAT_V} data-r="ni-start">–</span></div>
          <div class={STAT_KEY} data-live><span class={STAT_K} data-r="ni-now-k">Net income so far</span><span class={STAT_V} data-r="ni-now">–</span></div>
        </div>
        <ul class="grid" data-r="ni-list" aria-label="Each adjustment's effect on net income"></ul>
        <div class={VERDICT} data-r="ni-verdict" role="status"></div>
      </div>
      <div class={PANEL}>
        <h2 class={H2}>Four kinds of adjustments</h2>
        <table class={KINDS}>
          <tbody>
            <tr><th scope="row">Prepaid expense</th><td>Paid ahead (supplies, insurance), then used up. Asset down, expense up.</td></tr>
            <tr><th scope="row">Unearned revenue</th><td>Paid ahead by a customer, then earned. Liability down, revenue up.</td></tr>
            <tr><th scope="row">Accrued expense</th><td>Owed but not paid yet (wages, interest). Expense up, liability up.</td></tr>
            <tr><th scope="row">Accrued revenue</th><td>Earned but not collected yet. Receivable up, revenue up.</td></tr>
          </tbody>
        </table>
        <p class={HINT}><strong class="text-ink">Depreciation</strong> is like a prepaid expense for a long-lived asset: the cost gets used up a little each month.</p>
      </div>
    </div>
  </section>

  <section class={PANEL} aria-labelledby="ae-ws-h">
    <h2 id="ae-ws-h" class={H2}>Worksheet <span class="font-sans text-[13px] font-medium text-muted ml-1.5">Maya's Food Truck, end of month 2</span></h2>
    <div class={TABLE_BOX}>
      <table class={WS}>
        <thead>
          <tr><th scope="col"><span class="sr-only">Account</span></th><th scope="colgroup" colspan="2">Unadjusted</th><th scope="colgroup" colspan="2">Adjustments</th><th scope="colgroup" colspan="2">Adjusted</th></tr>
          <tr><th scope="col" class="text-left!">Account</th><th scope="col">Debit</th><th scope="col">Credit</th><th scope="col">Debit</th><th scope="col">Credit</th><th scope="col">Debit</th><th scope="col">Credit</th></tr>
        </thead>
        <tbody data-r="ws"></tbody>
        <tfoot><tr class="[&>*]:border-t-2 [&>*]:border-ink [&>*]:font-bold"><th scope="row" class="text-left! py-1.5 px-2 pl-0">Totals</th><td data-r="u-dr"></td><td data-r="u-cr"></td><td data-r="a-dr"></td><td data-r="a-cr"></td><td data-r="f-dr"></td><td data-r="f-cr"></td></tr></tfoot>
      </table>
    </div>
    <div class={VERDICT} data-r="ws-verdict" role="status"></div>
    <p class={HINT}>Letters in parentheses match each adjustment. The rows changed by the last entry are highlighted. On a phone, swipe the table sideways.</p>
  </section>

  <TryIt items={[
    { q: 'Every adjustment so far has changed one balance sheet account and one income statement account. Why does that have to be true?', a: 'Adjustments fix the timing of revenue and expenses. Each one moves an amount between a balance sheet account (an asset or a liability) and an income statement account (a revenue or an expense). Cash is never part of it.' },
    { q: 'Maya forgot all seven adjustments and reported the unadjusted profit. Was her profit too high or too low, and by how much?', a: 'Too high by $780. She would have reported $3,350 instead of $2,570, because she left out $1,480 of expenses and $700 of revenue.' },
    { q: 'Why does depreciation go in Accumulated Depreciation instead of reducing the Equipment account?', a: 'So the balance sheet still shows what the truck cost ($20,000) next to how much of that cost has been used ($600). Cost minus accumulated depreciation is the book value, $19,400.' },
    { q: 'Next month, Maya pays her helper the $240 she owes. Write that entry. Is it an expense next month?', a: 'Debit Wages Payable $240, credit Cash $240. It is not an expense next month: the expense was already recorded this month, when the work was done.' },
  ]} />
</div>

<script>
  import { initAdjustingEntries } from '../../scripts/tools/adjusting-entries.js';
  document.querySelectorAll('[data-tool="adjusting-entries"]').forEach(initAdjustingEntries);
</script>
