---
// Bank Reconciliation Lab: markup only. Behavior lives in src/scripts/tools/bank-reconciliation.js
import TryIt from '../ui/TryIt.astro';
import { PANEL, H2, H3, HINT, SELECT, NUM_INPUT_SM, NUM_UNIT, BTN, BTN_GHOST, TABLE_BOX, TABLE, VERDICT } from '../../scripts/lib/ui.js';

const ROW = 'grid grid-cols-[minmax(0,1fr)_auto] items-end gap-2 py-2 px-2 rounded-md border-l-[3px] border-transparent tone-good:bg-good-soft tone-good:border-good tone-bad:bg-bad-soft tone-bad:border-bad max-[420px]:grid-cols-1';
const SEL = `${SELECT} w-full min-w-0 disabled:opacity-100 disabled:text-ink`;
const AMT = `${NUM_INPUT_SM} w-[96px] disabled:opacity-100 disabled:text-ink`;
const LABEL = 'font-semibold text-[13.5px]';
// One side of the reconciliation: starting balance, items, adjusted balance.
const SIDE = 'grid gap-1 content-start text-[14px] min-w-0';
const LINE = 'flex justify-between gap-3 py-1';
const TOTAL = 'flex justify-between gap-3 border-t-2 border-ink pt-1.5 mt-1 font-semibold';
---
<div class="grid gap-[18px]" data-tool="bank-reconciliation">
  <section class="grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-[18px] items-start max-[900px]:grid-cols-1">
    <div class:list={[PANEL, 'group/card']} data-r="card">
      <div class="grid gap-1.5 text-[13px] text-muted font-medium">
        <span data-r="progress">Item 1 of 8</span>
        <div class="h-1 bg-grid rounded-[2px] overflow-hidden" aria-hidden="true"><div class="h-full w-0 bg-accent transition-[width] duration-300" data-r="bar"></div></div>
      </div>
      <p class="font-display text-[clamp(18px,2.4vw,22px)] font-semibold leading-[1.3] text-pretty" data-r="text" aria-live="polite"></p>
      <form class="grid gap-2 group-data-done/card:hidden" onsubmit="return false" aria-label="Place this item">
        <p class="text-[14px] text-muted">Which balance does this item fix, and which way? Some items don't need any adjustment.</p>
        <div class={ROW} data-r="row">
          <span class="grid gap-1 min-w-0">
            <label for="br-place" class={LABEL}>Where it goes</label>
            <select id="br-place" class={SEL}></select>
          </span>
          <span class="grid gap-1">
            <label for="br-amt" class={LABEL}>Amount</label>
            <span class="flex items-center gap-1"><span class={NUM_UNIT}>$</span><input id="br-amt" type="number" min="0" step="1" inputmode="numeric" placeholder="0" class={AMT} /></span>
          </span>
        </div>
      </form>
      <p class="rounded-lg py-2.5 px-3.5 text-[14.5px] tone-good:bg-good-soft tone-bad:bg-bad-soft tone-info:bg-bg" data-r="feedback" role="status" hidden></p>
      <span class="justify-self-start rounded-full bg-accent/12 text-ink px-2.5 py-0.5 text-[12.5px] font-semibold" data-r="kind" hidden></span>
      <p class="text-[15px] border-l-[3px] border-accent pl-3 max-w-[65ch]" data-r="why" hidden></p>
      <div class="flex flex-wrap gap-2">
        <button type="button" class={BTN} data-act="check">Check</button>
        <button type="button" class={BTN_GHOST} data-act="reveal">Show answer</button>
        <button type="button" class={BTN} data-act="next" hidden>Next item</button>
        <button type="button" class={BTN_GHOST} data-act="restart" hidden>Start over</button>
      </div>
    </div>

    <div class={PANEL}>
      <h2 class={H2}>Bank reconciliation <span class="font-sans text-[13px] font-medium text-muted ml-1.5">Maya's Food Truck, end of month 3</span></h2>
      <div class="grid grid-cols-2 gap-5 max-[480px]:grid-cols-1">
        <div class={SIDE} role="group" aria-labelledby="br-bank-h">
          <h3 id="br-bank-h" class={H3}>Bank statement</h3>
          <p class={LINE}><span>Balance</span><span class="font-mono tabular-nums" data-r="bank-start"></span></p>
          <ul class="grid text-[13.5px]" data-r="bank-list" aria-label="Bank side adjustments"></ul>
          <p class={TOTAL}><span>Adjusted</span><span class="font-mono tabular-nums" data-r="bank-adj"></span></p>
        </div>
        <div class={SIDE} role="group" aria-labelledby="br-book-h">
          <h3 id="br-book-h" class={H3}>Maya's Cash account</h3>
          <p class={LINE}><span>Balance</span><span class="font-mono tabular-nums" data-r="book-start"></span></p>
          <ul class="grid text-[13.5px]" data-r="book-list" aria-label="Maya's side adjustments"></ul>
          <p class={TOTAL}><span>Adjusted</span><span class="font-mono tabular-nums" data-r="book-adj"></span></p>
        </div>
      </div>
      <p class="text-[13.5px] text-muted">Difference: <span class="font-mono tabular-nums text-ink font-semibold" data-r="diff"></span></p>
      <div class={VERDICT} data-r="verdict" role="status"></div>
      <p class={HINT}><strong class="text-ink">Bank side:</strong> things Maya recorded that the bank hasn't seen yet. <strong class="text-ink">Maya's side:</strong> things the bank recorded that Maya doesn't know about yet, and her own mistakes.</p>
    </div>
  </section>

  <section class={PANEL} aria-labelledby="br-je-h">
    <h2 id="br-je-h" class={H2}>Journal entries Maya needs</h2>
    <p class={HINT} data-r="je-empty">Items on Maya's side change her Cash account, so each one needs a journal entry. They'll show up here.</p>
    <div class={TABLE_BOX} data-r="je-table" hidden>
      <table class:list={[TABLE, 'min-w-[420px]']}>
        <thead><tr><th scope="col" class="text-left!">Account</th><th scope="col">Debit</th><th scope="col">Credit</th></tr></thead>
        <tbody data-r="je"></tbody>
      </table>
    </div>
    <p class={HINT}>Items on the bank's side need no entry. The bank will catch up on its own when the deposit lands and the checks get cashed.</p>
  </section>

  <TryIt items={[
    { q: 'Why don\'t outstanding checks need a journal entry, but the bank\'s service fee does?', a: 'Maya already recorded the checks when she wrote them. The bank just hasn\'t paid them yet, and it will. The service fee is new information: Maya didn\'t know about it until the statement came, so she has to record it.' },
    { q: 'Before reconciling, the bank said $6,087 and Maya\'s records said $6,240. Which one was right?', a: 'Neither. The true balance is $6,137. The bank was missing Maya\'s deposit and checks, and Maya was missing the fee, the bounced check, the interest, and her own mistake.' },
    { q: 'Maya\'s customer bounced a $120 check. Why does the entry debit Accounts Receivable instead of an expense?', a: 'The customer still owes Maya the $120. It\'s money she can still try to collect, not a cost of running the truck.' },
    { q: 'Next month, check #218 shows up on the bank statement. Does it need a reconciliation adjustment then?', a: 'No. Once a check clears, it\'s on both the bank statement and Maya\'s records, so it no longer explains any difference.' },
  ]} />
</div>

<script>
  import { initBankReconciliation } from '../../scripts/tools/bank-reconciliation.js';
  document.querySelectorAll('[data-tool="bank-reconciliation"]').forEach(initBankReconciliation);
</script>
