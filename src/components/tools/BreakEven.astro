---
// Break-Even Lab: markup only. Behavior lives in src/scripts/tools/break-even.js
import RangeField from '../ui/RangeField.astro';
import Stat from '../ui/Stat.astro';
import TryIt from '../ui/TryIt.astro';
import { TOOL, PANEL, PANEL_TIGHT, LOWER, H2, PROSE, PRESETS, CHART_KEY, RESULTS, VERDICT, FORMULA } from '../../scripts/lib/ui.js';
---
<div class={TOOL} data-tool="break-even">
  <section class="grid grid-cols-[320px_minmax(0,1fr)] gap-[18px] items-start max-[860px]:grid-cols-1">
    <div class={PANEL} aria-label="Business inputs">
      <h2 class={H2}>Your business</h2>
      <div class={PRESETS} data-presets role="group" aria-label="Example businesses"></div>
      <RangeField id="be-price" label="Selling price" unit="$" step="0.25" max={50} width="w-[96px]" aria="Selling price in dollars" hint="What the customer pays for one item." />
      <RangeField id="be-vc" label="Variable cost per unit" unit="$" step="0.25" max={50} width="w-[96px]" aria="Variable cost per unit in dollars" hint="Costs that grow with every item: ingredients, materials, packaging." />
      <RangeField id="be-fc" label="Fixed costs" unit="$" step="10" max={10000} width="w-[96px]" aria="Fixed costs in dollars" hint="Costs you pay no matter what: rent, equipment, permits." />
      <RangeField id="be-q" label="Units you expect to sell" step="1" max={2000} width="w-[96px]" aria="Expected units sold" hint="Your sales forecast. The dashed line on the chart." />
    </div>

    <div class={PANEL_TIGHT}>
      <div class={CHART_KEY} aria-hidden="true">
        <span><i class="w-[18px] h-[3px] rounded-[2px] inline-block bg-good"></i>Total revenue</span>
        <span><i class="w-[18px] h-[3px] rounded-[2px] inline-block bg-bad"></i>Total cost</span>
        <span><i class="w-[18px] h-[3px] rounded-[2px] inline-block bg-accent"></i>Break-even point</span>
      </div>
      <div class="w-full overflow-x-auto"><svg data-chart viewBox="0 0 640 360" role="img" aria-label="Break-even chart" class="block w-full h-auto min-w-[340px] [&_text]:font-mono [&_text]:text-[11px] [&_text]:fill-muted"></svg></div>
      <div class={RESULTS}>
        <Stat label="Break-even units" r="units" keyed live />
        <Stat label="Break-even sales $" r="dollars" />
        <Stat label="Contribution margin" r="cm" />
        <Stat label="Profit at forecast" r="profit" box="profit-box" labelRef="profit-k" live />
      </div>
      <div class={VERDICT} data-r="verdict" role="status"></div>
    </div>
  </section>

  <section class={LOWER}>
    <div class={PANEL}>
      <h2 class={H2}>The math</h2>
      <div class={FORMULA} data-r="formula"></div>
      <p class={PROSE}><strong>Contribution margin</strong> is what each sale has left over after paying its own variable cost. That money goes toward covering fixed costs. Once enough sales cover all the fixed costs, every sale after that is profit.</p>
    </div>
    <TryIt items={[
      { q: "With the lemonade stand, what happens to break-even if you raise the price by $1? Why does such a small change matter so much?", hint: "Watch the contribution margin. How much more of the fixed costs does each cup cover now?", a: "Raising price raises contribution margin. Every cup now covers more of the fixed costs, so you need fewer cups." },
      { q: "Set the variable cost equal to the price. What does the chart show, and why?", hint: "Contribution margin is price minus variable cost. What is it now?", a: "Contribution margin is $0. Each sale only pays for itself, so nothing is left to cover fixed costs. The lines never cross." },
      { q: "The food truck owner can cut rent by $1,000 or cut variable cost by $1 per meal. Which lowers break-even more? Test both.", hint: "Test one change at a time, and write down each break-even number.", a: "Which one wins depends on the numbers, and choosing is the business decision. Be ready to defend your pick with both break-even numbers." },
    ]} defend={{
      q: "A friend is running the lemonade stand at a one-day school event with about 120 customers. Would you charge $2 or $3? Defend your pick.",
      hint: "Find break-even at each price. Then set the units you expect to sell. How many of the 120 would still buy at $3?",
      look: [
        "Finds break-even at each price (100 cups at $2, 60 at $3)",
        "Asks whether 120 people will really buy at the higher price",
        "Uses the profit at forecast number to compare",
        "Picks a price and says what would change their mind",
      ],
    }} />
  </section>
</div>

<script>
  import { initBreakEven } from '../../scripts/tools/break-even.js';
  document.querySelectorAll('[data-tool="break-even"]').forEach(initBreakEven);
</script>
