---
// Closing Entries Lab: markup only. Behavior lives in src/scripts/tools/closing-entries.js
import TryIt from '../ui/TryIt.astro';
import { PANEL, H2, H3, HINT, SELECT, NUM_INPUT_SM, NUM_UNIT, BTN, BTN_GHOST, TABLE_BOX, TABLE, VERDICT, FIELDSET, LEGEND } from '../../scripts/lib/ui.js';
import { ACCOUNTS } from '../../scripts/tools/adjusting-entries.js';

// Entry rows: a checked row gets data-tone="good" or "bad".
const ROW = 'grid grid-cols-[4.2rem_minmax(0,1fr)_auto] items-center gap-2 py-1.5 px-2 rounded-md border-l-[3px] border-transparent tone-good:bg-good-soft tone-good:border-good tone-bad:bg-bad-soft tone-bad:border-bad max-[420px]:grid-cols-[minmax(0,1fr)_auto] max-[420px]:[&>label]:col-span-2';
const SEL = `${SELECT} w-full min-w-0 disabled:opacity-100 disabled:text-ink`;
const AMT = `${NUM_INPUT_SM} w-[96px] disabled:opacity-100 disabled:text-ink`;
// Sort checkboxes: a checked answer gets data-tone="good" or "bad" on the label.
const CHECK = 'flex items-center gap-2 text-[14px] py-1 px-2 rounded-md border-l-[3px] border-transparent cursor-pointer has-disabled:cursor-default tone-good:bg-good-soft tone-good:border-good tone-bad:bg-bad-soft tone-bad:border-bad';
const SORT_GROUPS = [
  ['Assets', ['A', 'K']],
  ['Liabilities', ['L']],
  ['Owner\'s equity', ['C', 'D']],
  ['Revenue and expenses', ['R', 'X']],
];
const TB = `${TABLE} text-[13px] min-w-[520px] [&_tbody_th]:sticky [&_tbody_th]:left-0 [&_tbody_th]:z-1 [&_tbody_th]:bg-panel [&_tfoot_th]:sticky [&_tfoot_th]:left-0 [&_tfoot_th]:bg-panel [&_thead_tr:last-child_th:first-child]:sticky [&_thead_tr:last-child_th:first-child]:left-0 [&_thead_tr:last-child_th:first-child]:bg-panel max-[700px]:[&_tbody_th]:max-w-[9.5rem] max-[700px]:[&_tbody_th]:pr-2 [&_thead_tr:first-child_th]:text-center [&_thead_tr:first-child_th]:text-ink [&_td:nth-child(4)]:border-l-2 [&_td:nth-child(4)]:border-l-line`;
---
<div class="grid gap-[18px]" data-tool="closing-entries">
  <section class="grid grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] gap-[18px] items-start max-[900px]:grid-cols-1">
    <div class:list={[PANEL, 'group/card']} data-r="card" data-phase="sort">
      <div class="grid gap-1.5 text-[13px] text-muted font-medium">
        <span data-r="progress">Step 1 of 5: Which accounts close?</span>
        <div class="h-1 bg-grid rounded-[2px] overflow-hidden" aria-hidden="true"><div class="h-full w-0 bg-accent transition-[width] duration-300" data-r="bar"></div></div>
      </div>
      <p class="font-display text-[clamp(18px,2.4vw,22px)] font-semibold leading-[1.3] text-pretty" data-r="text" aria-live="polite"></p>

      <div class="grid grid-cols-2 gap-3 items-start max-[560px]:grid-cols-1 group-data-[phase=entry]/card:hidden group-data-[phase=done]/card:hidden" data-sort>
        {SORT_GROUPS.map(([label, types]) => (
          <fieldset class={FIELDSET}>
            <legend class={LEGEND}>{label}</legend>
            <div class="grid gap-0.5 content-start">
              {ACCOUNTS.filter((a) => types.includes(a.type)).map((a) => (
                <label class={CHECK}><input type="checkbox" value={a.id} id={`ce-sort-${a.id}`} class="accent-accent w-4 h-4 m-0 shrink-0" /> {a.name}</label>
              ))}
            </div>
          </fieldset>
        ))}
      </div>

      <form class="grid gap-2 group-data-[phase=sort]/card:hidden group-data-[phase=done]/card:hidden" onsubmit="return false" aria-label="Closing entry">
        <p class="text-[14px] text-muted">Write the closing entry. Use the adjusted balances in the table below.</p>
        <div class={ROW} data-r="dr-row">
          <label for="ce-dr" class="font-semibold text-[14px]">Debit</label>
          <select id="ce-dr" class={SEL}></select>
          <span class="flex items-center gap-1"><span class={NUM_UNIT}>$</span><input id="ce-dr-amt" type="number" min="0" step="1" inputmode="numeric" placeholder="0" aria-label="Debit amount in dollars" class={AMT} /></span>
        </div>
        <div class:list={[ROW, 'pl-6']} data-r="cr-row">
          <label for="ce-cr" class="font-semibold text-[14px]">Credit</label>
          <select id="ce-cr" class={SEL}></select>
          <span class="flex items-center gap-1"><span class={NUM_UNIT}>$</span><input id="ce-cr-amt" type="number" min="0" step="1" inputmode="numeric" placeholder="0" aria-label="Credit amount in dollars" class={AMT} /></span>
        </div>
      </form>
      <p class="rounded-lg py-2.5 px-3.5 text-[14.5px] tone-good:bg-good-soft tone-bad:bg-bad-soft tone-info:bg-bg" data-r="feedback" role="status" hidden></p>
      <p class="text-[15px] border-l-[3px] border-accent pl-3 max-w-[65ch]" data-r="why" hidden></p>
      <div class="flex flex-wrap gap-2">
        <button type="button" class={BTN} data-act="check">Check my sort</button>
        <button type="button" class={BTN_GHOST} data-act="reveal">Show answer</button>
        <button type="button" class={BTN} data-act="next" hidden>Start the closing entries</button>
        <button type="button" class={BTN_GHOST} data-act="restart" hidden>Start over</button>
      </div>
    </div>

    <div class="grid gap-[18px]">
      <div class={PANEL}>
        <h2 class={H2}>Where the balances go</h2>
        <div class="grid gap-5">
          <div class="grid gap-1 content-start" role="group" aria-label="Income Summary T-account">
            <h3 class:list={[H3, 'text-center']}>Income Summary</h3>
            <div data-r="t-is"></div>
          </div>
          <div class="grid gap-1 content-start" role="group" aria-label="Maya, Capital T-account">
            <h3 class:list={[H3, 'text-center']}>Maya, Capital</h3>
            <div data-r="t-cap"></div>
          </div>
        </div>
        <div class={VERDICT} data-r="t-verdict" role="status"></div>
      </div>
      <div class={PANEL}>
        <h2 class={H2}>The four closing entries</h2>
        <ol class="m-0 pl-5 grid gap-1 list-decimal text-[14px]">
          <li>Revenue → Income Summary</li>
          <li>Expenses → Income Summary</li>
          <li>Income Summary → Capital</li>
          <li>Drawing → Capital</li>
        </ol>
        <p class={HINT}><strong class="text-ink">To close an account,</strong> put its balance on the opposite side. An account with a credit balance gets debited, and the other way around.</p>
      </div>
    </div>
  </section>

  <section class={PANEL} aria-labelledby="ce-tb-h">
    <h2 id="ce-tb-h" class={H2}>Trial balance <span class="font-sans text-[13px] font-medium text-muted ml-1.5">Maya's Food Truck, end of month 2</span></h2>
    <div class={TABLE_BOX}>
      <table class={TB}>
        <thead>
          <tr><th scope="col"><span class="sr-only">Account</span></th><th scope="colgroup" colspan="2">Adjusted</th><th scope="colgroup" colspan="2">After closing</th></tr>
          <tr><th scope="col" class="text-left!">Account</th><th scope="col">Debit</th><th scope="col">Credit</th><th scope="col">Debit</th><th scope="col">Credit</th></tr>
        </thead>
        <tbody data-r="tb"></tbody>
        <tfoot><tr class="[&>*]:border-t-2 [&>*]:border-ink [&>*]:font-bold"><th scope="row" class="text-left! py-1.5 px-2 pl-0">Totals</th><td data-r="adj-dr"></td><td data-r="adj-cr"></td><td data-r="pc-dr"></td><td data-r="pc-cr"></td></tr></tfoot>
      </table>
    </div>
    <div class={VERDICT} data-r="tb-verdict" role="status"></div>
    <p class={HINT}>The adjusted balances come from the Adjusting Entries Lab. Rows changed by the last entry are highlighted. On a phone, swipe the table sideways.</p>
  </section>

  <TryIt items={[
    { q: 'Why do revenue and expense accounts get closed, but Cash and Equipment don\'t?', a: 'Revenue and expenses measure one month, so each month needs to start at zero. Cash and Equipment are things Maya still has on the first day of next month, so their balances carry over.' },
    { q: 'If Maya forgot to close her accounts, what would her Sales Revenue show at the end of month 3? Why is that a problem?', a: 'Months 2 and 3 added together. Her month 3 income statement would show more revenue than she earned that month, and her Capital would be out of date.' },
    { q: 'Maya took out $800. Why didn\'t that lower her net income?', a: 'Drawing isn\'t an expense. It doesn\'t help earn revenue. It closes straight to Capital, so it lowers her equity but not her profit.' },
    { q: 'Suppose Maya had a $500 loss instead of a profit. Which side of Income Summary would hold the balance, and how would entry 3 change?', a: 'A loss means expenses are bigger than revenue, so Income Summary has a $500 debit balance. Entry 3 flips: debit Maya, Capital $500, credit Income Summary $500. Her capital goes down.' },
  ]} />
</div>

<script>
  import { initClosingEntries } from '../../scripts/tools/closing-entries.js';
  document.querySelectorAll('[data-tool="closing-entries"]').forEach(initClosingEntries);
</script>
