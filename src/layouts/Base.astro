---
import '../styles/global.css';
const { title, description = 'Free interactive tools for high school business and personal finance classes.', noindex = false } = Astro.props;
const siteName = 'Business Labs';
const pageTitle = title ? `${title} · ${siteName}` : siteName;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- Embed mode and theme: run before paint so nothing flashes.
         Theme order: ?theme=light|dark (for slide links, not saved), then the header toggle's saved
         choice, then the device setting. Saving is a convenience only; it fails quietly. -->
    <script is:inline>
      (function () {
        var html = document.documentElement;
        var q = new URLSearchParams(location.search);
        if (q.get('embed') === '1') html.classList.add('embed');
        var mq = matchMedia('(prefers-color-scheme: dark)');
        var urlTheme = /^(light|dark)$/.test(q.get('theme')) ? q.get('theme') : null;
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) {}
        function apply() {
          var t = urlTheme || (saved === 'light' || saved === 'dark' ? saved : mq.matches ? 'dark' : 'light');
          html.dataset.theme = t;
          document.dispatchEvent(new Event('themechange'));
        }
        apply();
        mq.addEventListener && mq.addEventListener('change', apply);
        window.__setTheme = function (t) {
          urlTheme = null;
          // Picking the same theme as the device goes back to following the device.
          saved = t === (mq.matches ? 'dark' : 'light') ? null : t;
          try { saved ? localStorage.setItem('theme', saved) : localStorage.removeItem('theme'); } catch (e) {}
          apply();
        };
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="site-chrome border-b border-line bg-panel print:hidden">
      <div class="mx-auto max-w-6xl px-4 py-3 flex items-center justify-between gap-4">
        <a href="/" class="font-display text-xl font-bold no-underline text-ink">{siteName}</a>
        <nav class="flex items-center gap-5 text-sm font-medium text-muted">
          <a href="/" class="hover:text-ink">Tools</a>
          <a href="/standards/" class="hover:text-ink">Standards</a>
          <button type="button" data-theme-toggle aria-label="Switch to dark mode" title="Switch to dark mode" class="-mr-2 grid place-items-center size-9 rounded-lg text-muted hover:text-ink hover:bg-bg cursor-pointer">
            <svg class="size-[18px] dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="size-[18px] hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </nav>
      </div>
    </header>
    <main class="flex-1 mx-auto w-full max-w-6xl px-4 py-8">
      <slot />
    </main>
    <footer class="site-chrome border-t border-line text-sm text-muted print:hidden">
      <div class="mx-auto max-w-6xl px-4 py-5">
        No accounts, no tracking of students. Everything runs in your browser.
      </div>
    </footer>
    <script>
      // Header light/dark toggle. The theme itself is applied by the inline script in <head>.
      const btn = document.querySelector('[data-theme-toggle]');
      const label = () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        btn.setAttribute('aria-label', `Switch to ${next} mode`);
        btn.title = `Switch to ${next} mode`;
      };
      btn?.addEventListener('click', () => {
        window.__setTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
      });
      document.addEventListener('themechange', label);
      if (btn) label();
    </script>
  </body>
</html>
