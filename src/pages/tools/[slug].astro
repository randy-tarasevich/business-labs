---
// Student-facing tool page. Teacher notes live on /teachers/<slug>/ and must never be rendered here:
// anything on this page is readable by students in the page source.
import Base from '../../layouts/Base.astro';
import Challenges from '../../components/ui/Challenges.astro';
import Predictions from '../../components/ui/Predictions.astro';
import { getCollection } from 'astro:content';
import { TOOL_COMPONENTS } from '../../components/tools/index.js';
import { MIN_TOOLS, courseSlug, courseStyle } from '../../data/courses.js';

export async function getStaticPaths() {
  const tools = await getCollection('tools', ({ data }) => !data.draft);
  const counts = {};
  tools.forEach((t) => t.data.courses.forEach((c) => (counts[c] = (counts[c] || 0) + 1)));
  const withPages = Object.keys(counts).filter((c) => counts[c] >= MIN_TOOLS);
  return tools.map((tool) => ({ params: { slug: tool.id }, props: { tool, withPages } }));
}

const { tool, withPages } = Astro.props;
const Tool = TOOL_COMPONENTS[tool.data.component];
// The timer has nothing to print, and the Business Plan Builder prints the student's plan itself.
const printable = !['ClassTimer', 'BusinessPlan'].includes(tool.data.component);
// Share links save a tool's inputs in the URL (src/scripts/lib/share-state.js). These tools keep their
// state in something other than plain inputs, so they don't get a Copy link button.
const SKIP_SHARE = ['ClassTimer', 'BusinessPlan', 'BudgetBalancer', 'AccountingEquation', 'TAccounts', 'AdjustingEntries', 'ClosingEntries'];
const shareable = !SKIP_SHARE.includes(tool.data.component);
if (!Tool) throw new Error(`No component "${tool.data.component}" registered in src/components/tools/index.js`);
---
<Base title={tool.data.title} description={tool.data.summary}>
  <!-- The title stays in projector view (?embed=1) so the class knows which tool is up. -->
  <div class="mb-6 grid gap-1 print:hidden embed:mb-4" data-share-ok={shareable ? '' : undefined}>
    <a href="/" class="site-chrome text-sm text-muted hover:text-ink">← All tools</a>
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <h1 class="text-3xl sm:text-4xl font-extrabold">{tool.data.title}</h1>
      <div class="site-chrome flex flex-wrap gap-2">
      {shareable && (
        <button type="button" data-share class="inline-flex items-center gap-2 rounded-lg border border-line bg-panel px-3.5 py-2 text-sm font-semibold text-ink hover:border-accent cursor-pointer" title="Copy a link that opens this tool with your current numbers">
          <svg class="size-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
          <span data-share-label>Copy link</span>
        </button>
      )}
      {shareable && (
        <button type="button" data-copy-results data-title={tool.data.title} class="inline-flex items-center gap-2 rounded-lg border border-line bg-panel px-3.5 py-2 text-sm font-semibold text-ink hover:border-accent cursor-pointer" title="Copy your numbers and results as text, to paste into a Google Form or Doc">
          <svg class="size-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="13" height="13" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/></svg>
          <span data-copy-label>Copy results</span>
        </button>
      )}
      {printable && (
        <button type="button" data-print class="inline-flex items-center gap-2 rounded-lg border border-line bg-panel px-3.5 py-2 text-sm font-semibold text-ink hover:border-accent cursor-pointer" title="Print a worksheet with your current numbers and space to answer the Try it questions">
          <svg class="size-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V3h12v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M7 14h10v7H7z"/></svg>
          Print
        </button>
      )}
      <a href="?embed=1" data-project class="site-chrome inline-flex items-center gap-2 rounded-lg border border-line bg-panel px-3.5 py-2 text-sm font-semibold text-ink hover:border-accent max-[860px]:hidden" title="Full-width view without the site header, for a projector or a slide link">
        <svg class="size-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
        Project
      </a>
      </div>
    </div>
    <p class="site-chrome text-muted">{tool.data.unit} · Grades {tool.data.grades}</p>
    <!-- Every course this tool fits, home course first. Courses with a page link to it. -->
    <ul class="site-chrome mt-2 flex flex-wrap gap-2" aria-label="Courses">
      {tool.data.courses.map((c) => (
        <li style={courseStyle(c)}>
          {withPages.includes(c) ? (
            <a href={`/courses/${courseSlug(c)}/`} class="inline-flex items-center gap-2 min-h-8 rounded-full border border-line bg-panel px-3 py-1 text-[13.5px] font-medium hover:border-(--course) hover:text-(--course)">
              <span class="size-2 shrink-0 rounded-full bg-(--course)" aria-hidden="true"></span>{c}
            </a>
          ) : (
            <span class="inline-flex items-center gap-2 min-h-8 rounded-full border border-line px-3 py-1 text-[13.5px] font-medium text-muted">
              <span class="size-2 shrink-0 rounded-full bg-(--course)" aria-hidden="true"></span>{c}
            </span>
          )}
        </li>
      ))}
    </ul>
  </div>

  <!-- Worksheet header: only on paper. -->
  <div class="hidden print:block mb-4">
    <div class="flex gap-6 text-[11pt]">
      <span class="flex flex-1 items-end gap-2">Name <span class="flex-1 border-b border-ink"></span></span>
      <span class="flex w-[28%] items-end gap-2">Date <span class="flex-1 border-b border-ink"></span></span>
      <span class="flex w-[20%] items-end gap-2">Class <span class="flex-1 border-b border-ink"></span></span>
    </div>
    <h1 class="mt-4 text-2xl font-extrabold">{tool.data.title}</h1>
    <p class="text-muted">{tool.data.unit} · Business Labs</p>
  </div>

  <Tool {...tool.data.props} />
  {shareable && (
    <div class="mt-[18px] grid gap-[18px] empty:hidden">
      <Predictions slug={tool.id} />
      <Challenges slug={tool.id} />
    </div>
  )}
</Base>

<script>
  // Phone results bar for tools that mark results with data-live, and the projector view
  // toggles that keep explanations and Try it questions collapsed until the teacher opens them.
  import { initLiveBar } from '../../scripts/lib/live-bar.js';
  import { initProjector } from '../../scripts/lib/projector.js';
  import { initPrint } from '../../scripts/lib/print.js';
  import { initShareState, stateUrl } from '../../scripts/lib/share-state.js';
  import { initChallenges } from '../../scripts/lib/challenges.js';
  import { initPredictions } from '../../scripts/lib/predictions.js';
  import { summary } from '../../scripts/lib/copy-results.js';
  import { sliderText, scrollRegions } from '../../scripts/lib/a11y.js';

  // The Project button opens projector view with the numbers currently on screen.
  const project = document.querySelector<HTMLAnchorElement>('[data-project]');
  const syncProject = () => project && (project.href = stateUrl({ embed: '1' }));
  const shareOk = document.querySelector('[data-share-ok]') !== null;

  document.querySelectorAll<HTMLElement>('[data-tool]').forEach((root) => {
    initLiveBar(root);
    sliderText(root);
    scrollRegions(root);
    initProjector(root);
    initPrint(root);
    if (shareOk) initShareState(root, { onChange: syncProject });
    // Challenge cards check themselves after the share link has loaded its numbers.
    const panel = document.querySelector<HTMLElement>('[data-challenges]');
    if (panel) initChallenges(root, panel);
    const predict = document.querySelector<HTMLElement>('[data-predictions]');
    if (predict) initPredictions(root, predict);
  });
  syncProject();
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());

  // Copy link: the page URL already holds the tool's numbers. Leave out projector view so students
  // who open it get the normal page.
  const share = document.querySelector('[data-share]');
  const label = share?.querySelector('[data-share-label]');
  let reset: ReturnType<typeof setTimeout>;
  share?.addEventListener('click', async () => {
    const url = stateUrl({ embed: null, theme: null });
    try {
      await navigator.clipboard.writeText(url);
      if (label) label.textContent = 'Link copied';
    } catch {
      window.prompt('Copy this link:', url);
    }
    clearTimeout(reset);
    reset = setTimeout(() => label && (label.textContent = 'Copy link'), 2000);
  });

  // Copy results: numbers, results, and a link as plain text, for an exit ticket in a Google Form or Doc.
  const copyBtn = document.querySelector<HTMLElement>('[data-copy-results]');
  const copyLabel = copyBtn?.querySelector('[data-copy-label]');
  const toolRoot = document.querySelector<HTMLElement>('[data-tool]');
  let copyReset: ReturnType<typeof setTimeout>;
  copyBtn?.addEventListener('click', async () => {
    if (!toolRoot) return;
    const text = summary(toolRoot, { title: copyBtn.dataset.title || document.title, url: stateUrl({ embed: null, theme: null }) });
    let ok = false;
    try {
      await navigator.clipboard.writeText(text);
      ok = true;
    } catch {
      // Older browsers: copy from a hidden text box instead.
      const box = document.createElement('textarea');
      box.value = text;
      box.setAttribute('readonly', '');
      box.className = 'fixed top-0 left-0 opacity-0 pointer-events-none';
      document.body.append(box);
      box.select();
      ok = document.execCommand('copy');
      box.remove();
    }
    if (copyLabel) copyLabel.textContent = ok ? 'Results copied' : 'Copy failed';
    clearTimeout(copyReset);
    copyReset = setTimeout(() => copyLabel && (copyLabel.textContent = 'Copy results'), 2000);
  });
</script>
