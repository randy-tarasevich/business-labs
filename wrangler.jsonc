{
  // Cloudflare Workers static-assets deploy for the Astro build.
  "name": "business-labs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Branch builds run `npx wrangler preview`, which requires this block (it can stay empty).
  // It gives every non-main branch its own preview link for review before merging.
  // https://developers.cloudflare.com/workers/previews/configuration/#wrangler-configuration-file
  "previews": {}
}
